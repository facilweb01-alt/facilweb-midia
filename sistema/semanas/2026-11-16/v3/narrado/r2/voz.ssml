<speak version="1.0" xmlns="http://www.w3.org/2001/10/synthesis" xmlns:mstts="https://www.w3.org/2001/mstts" xml:lang="pt-BR"><voice name="pt-BR-FranciscaNeural"><prosody rate="+6%">
<bookmark mark="s1"/>A Black Friday tá chegando. E a sua margem, pra onde vai?<break time="200ms"/>
<bookmark mark="s2"/>No app, o desconto sai do seu bolso, e a comissão continua.<break time="200ms"/>
<bookmark mark="s3"/>No seu cardápio digital, a promoção roda na roleta de cupons.<break time="200ms"/>
<bookmark mark="s4"/>O cupom entra direto no pedido, e a taxa é zero.<break time="350ms"/>
<bookmark mark="s5"/>Promoção sua, lucro seu.<break time="200ms"/>
<bookmark mark="s6"/>Fácil Web. Cardápio digital sem comissão.<break time="200ms"/>
</prosody></voice></speak>
