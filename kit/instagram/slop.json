  "structures": [
    {
      "id": "nao-e-so",
      "regex": "(?i)\\bnão (?:é|se trata de) (?:só|apenas|somente) [^.!?\\n]{2,60}[,.;] (?:é|mas|e sim)\\b",
      "name": "\"Não é só X, é Y\"",
      "fix": "Diga a única coisa que você quer dizer. Apague a metade da preparação."
    },
    {
      "id": "nao-so-mas",
      "regex": "(?i)\\bnão (?:só|apenas|somente)\\b[^.!?\\n]{2,80}\\bmas (?:também|tb)\\b",
      "name": "\"Não só X, mas também Y\"",
      "fix": "Divida em duas frases ou corte a metade mais fraca."
    },
    {
      "id": "nao-e-sobre",
      "regex": "(?i)\\b(?:isso|não) (?:não )?é sobre [^.!?\\n]{2,60}[.!] (?:é|e sim) sobre\\b",
      "name": "\"Não é sobre X. É sobre Y.\"",
      "fix": "Comece pelo Y. A inversão é a assinatura."
    },
    {
      "id": "o-resultado",
      "regex": "(?im)^\\s*(?:o resultado|a melhor parte|o detalhe|a pegadinha|o segredo|sabe o que aconteceu|e o resultado)\\?\\s*$",
      "name": "Pergunta retórica numa linha só",
      "fix": "Responda direto em vez de encenar a revelação."
    },
    {
      "id": "o-que-aprendi",
      "regex": "(?i)\\b(?:aqui está|aqui vai|eis) o que (?:eu )?aprendi\\b|\\bo que (?:eu )?aprendi com isso\\b",
      "name": "\"Aqui está o que eu aprendi\"",
      "fix": "Diga a lição. Pule o anúncio."
    },
    {
      "id": "trinca",
      "regex": "(?i)\\b[^\\W\\d_]+, [^\\W\\d_]+ e [^\\W\\d_]+\\.",
      "name": "Regra de três (trinca)",
      "fix": "Dois itens ou quatro. Três é o ritmo padrão da máquina."
    },
    {
      "id": "foguete",
      "regex": "[🚀🔥💡✨🎯]",
      "name": "Emoji de foguete / fogo / lâmpada / brilho / alvo",
      "fix": "No máximo um emoji, e não um desses cinco."
    },
    {
      "id": "parede-hashtag",
      "regex": "(?:#\\w+[ \\t]*){6,}",
      "name": "Parede de hashtags (6+)",
      "fix": "Até 5. Desde dezembro de 2025 o Instagram limita a 5 por post, e as que passam disso não contam."
    },
    {
      "id": "como-ia",
      "regex": "(?i)\\bcomo (?:uma )?(?:ia|inteligência artificial|modelo de linguagem)\\b",
      "name": "Autorreferência de modelo",
      "fix": "Apague a frase."
    },
    {
      "id": "em-resumo",
      "regex": "(?im)^\\s*(?:em resumo|em suma|resumindo|concluindo|em conclusão|para concluir)\\b",
      "name": "Abertura de conclusão de redação",
      "fix": "Post não precisa de parágrafo de conclusão."
    },
    {
      "id": "isca-engajamento",
      "regex": "(?im)(?:concorda\\?|concordam\\?|o que (?:você|vocês|vc|vcs) acha(?:m)?\\?|quem mais\\b[^\\n?]*\\?|(?:tô|estou) errad[oa]\\?)\\s*$",
      "name": "Isca de engajamento no reflexo",
      "fix": "Faça uma pergunta que só você faria, sobre a coisa específica acima dela."
    },
    {
      "id": "para-de-rolar",
      "regex": "(?im)^\\s*(?:para de rolar|pare de rolar|não role|não passa|não pula|para tudo|espera,? não)\\b",
      "name": "Abertura \"para de rolar\"",
      "fix": "O que para o dedo tem que ser a própria afirmação. Pedir atenção é o sinal de que você ainda não ganhou."
    },
    {
      "id": "nesse-video",
      "regex": "(?i)\\b(?:n[eo]ss?e vídeo|n[eo]ste vídeo|no vídeo de hoje|n[eo]ss?e reels?|hoje eu vou (?:te |lhes? )?(?:mostrar|ensinar|falar)|vou (?:te |lhes? )?(?:mostrar|ensinar) como)\\b",
      "name": "Preâmbulo de vídeo (\"nesse vídeo eu vou te mostrar\")",
      "fix": "Apague e comece pela entrega. Os dois primeiros segundos decidem o reel inteiro."
    },
    {
      "id": "voce-sabia",
      "regex": "(?im)^\\s*(?:você sabia|vc sabia|sabia que|vocês sabiam)\\b",
      "name": "Abertura \"Você sabia que...\"",
      "fix": "Diga o fato direto. A pergunta só atrasa a informação."
    },
    {
      "id": "emoji-lista",
      "regex": "(?m)^\\s*[🌀-🫿✅➡⬅✔✨]\\s*\\S",
      "name": "Lista com emoji no lugar do marcador",
      "fix": "Use hífen ou quebra de linha. Lista com emoji é o que mais parece template numa legenda."
    },
    {
      "id": "hashtag-sem-cerquilha",
      "regex": "(?m)#\\w+(?:[ \\t]+#\\w+)*(?:[ \\t]+[^\\s#]\\w+){3,}[ \\t]*$",
      "name": "Hashtags sem # no fim da legenda (texto morto)",
      "fix": "As palavras depois das hashtags perderam o #. Não viram etiqueta nem busca; só poluem. Apague ou escolha até 5 hashtags de verdade."
    },
    {
      "id": "caps-grito",
      "regex": "\\b[A-ZÀ-Ý]{3,}\\b(?:\\s+\\b[A-ZÀ-Ý]{3,}\\b){2,}",
      "name": "Três ou mais palavras gritadas seguidas",
      "fix": "Caixa alta é botão de volume, não marca-texto. Uma palavra, no máximo."
    },
    {
      "id": "isca-seguir",
      "regex": "(?i)\\b(?:segue pra mais|segue para mais|me segue pra|marca (?:alguém|aquele amigo|um amigo|quem)|dá dois toques|deixa (?:seu|o) like|ativa o sininho|compartilha se)\\b",
      "name": "Isca de seguir ou marcar no reflexo",
      "fix": "Peça a única ação que este post realmente merece. O pedido genérico ensina o público a ignorar todos os pedidos."
    }
